PORT=5000
NODE_ENV=development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=propertysearch
DB_USER=postgres
DB_PASSWORD=postgres

# JWT
JWT_ACCESS_SECRET=change_this_access_secret
JWT_REFRESH_SECRET=change_this_refresh_secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# OTP
OTP_EXPIRY_MINUTES=5
OTP_LENGTH=6

# Password reset
RESET_TOKEN_EXPIRY_MINUTES=30

# Email (SMTP) - used for OTP/reset-link delivery and other platform emails
# once wired up (see the "integrate with SMS/Email provider" TODO comments
# in auth.service.js). SMTP_PORT 587 = STARTTLS -> SMTP_SECURE=false;
# port 465 (implicit TLS) would need SMTP_SECURE=true instead.
# SMTP_PASSWORD is a Gmail App Password (not the account password) - generate
# one at https://myaccount.google.com/apppasswords for info@propertyserch.com.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=info@propertyserch.com
SMTP_PASSWORD=your_gmail_app_password_here
SMTP_FROM_NAME=PropertySerch.com
SMTP_FROM_EMAIL=info@propertyserch.com

# AI Lead Qualification (Anthropic API)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# WhatsApp Integration (Meta Cloud API) - not yet wired to a real call, see
# whatsapp.service.js TODO comments
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
